# 이 파일은 git 에 커밋되는 템플릿이다. 실제 값을 넣지 않는다.
# 사용법:  cp .env.example .env  후 .env 에 값을 채운다.
# Vite 는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출한다.

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# REST API 키가 아니다.
VITE_KAKAO_MAP_KEY=

# Supabase 프로젝트 설정 > API
# anon(publishable) 키다. service_role 키는 절대 여기에 넣지 않는다.
# 값이 비어 있으면 로그인 기능만 꺼지고, 지도·업로드는 그대로 동작한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
